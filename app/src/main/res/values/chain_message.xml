    <!-- Chain Message explainer -->
    <string name="chain_description_title">What is a Chain Message?</string>
    <string name="chain_description_body">
        Start a short message and pass it on to friends. Each person adds one line and hands it to the next. When it reaches your chosen length (3–10), the full chain unlocks for all participants — you can read it and save it locally.
    </string>
    <string name="chain_description_hint">
        Tip: Choose the first friend and the chain length. If someone is busy, you can reroute the turn after a while.
    </string>

