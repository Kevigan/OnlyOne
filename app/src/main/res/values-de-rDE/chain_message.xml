    <!-- Chain Message explainer -->
    <string name="chain_description_title">Was ist eine Kettennachricht?</string>
    <string name="chain_description_body">
        Starte eine kurze Nachricht und gib sie an Freunde weiter. Jede Person fügt eine Zeile hinzu und gibt sie weiter. Sobald die gewählte Länge (3–10) erreicht ist, wird die komplette Kette für alle Teilnehmer freigeschaltet – ihr könnt sie lesen und lokal speichern.
    </string>
    <string name="chain_description_hint">
        Tipp: Wähle den ersten Freund und die Kettenlänge. Wenn jemand beschäftigt ist, kannst du den Zug später umleiten.
    </string>

