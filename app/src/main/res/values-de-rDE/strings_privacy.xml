<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Datenschutz (In-App + Aktionen) -->
    <string name="settings_privacy_header">Datenschutz</string>
    <string name="settings_privacy_subtitle">Verwalte deine Datenschutz- und Datenoptionen.</string>

    <string name="settings_privacy_intro_title">Kurze Datenschutz-Zusammenfassung</string>
    <string name="settings_privacy_intro_body">
        Dies ist eine leicht verständliche Zusammenfassung, wie Only One mit Daten umgeht.
        Für Fragen oder Anfragen kontaktiere uns bitte.
    </string>

    <string name="settings_privacy_collect_title">Welche Daten wir erheben</string>
    <string name="settings_privacy_collect_1">Konto-E-Mail und Anzeigename</string>
    <string name="settings_privacy_collect_2">Dein gesetzter Status-Text</string>
    <string name="settings_privacy_collect_3">Nachrichten und Reaktionen, die du sendest/empfängst</string>
    <string name="settings_privacy_collect_4">Swipe-Nutzung und Abo-Status</string>
    <string name="settings_privacy_collect_5">Freundesliste und Basis-Profilangaben</string>
    <string name="settings_privacy_collect_6">Benachrichtigungs-Token (für Push-Nachrichten)</string>

    <string name="settings_privacy_use_title">Wofür wir sie nutzen</string>
    <string name="settings_privacy_use_1">Anmeldung und Sitzungsverwaltung</string>
    <string name="settings_privacy_use_2">Zustellung von Nachrichten, Reaktionen und Benachrichtigungen</string>
    <string name="settings_privacy_use_3">Durchsetzung von Tageslimits und Swipe-Kontingenten</string>
    <string name="settings_privacy_use_4">Verbesserung der Zuverlässigkeit und Missbrauchsvermeidung</string>

    <string name="settings_privacy_store_title">Wo die Daten gespeichert werden</string>
    <string name="settings_privacy_store_body">
        Die Anmeldung erfolgt über Firebase Auth. App-Daten liegen in Firebase Firestore.
        Dein Gerät hält einen kleinen lokalen Cache (z. B. jüngste Nachrichten), um die App zu beschleunigen.
    </string>

    <string name="settings_privacy_retention_title">Speicherdauer</string>
    <string name="settings_privacy_retention_body">
        Jüngste Nachrichten können lokal zwischengespeichert und automatisch bereinigt werden.
        Server-Daten werden gespeichert, solange dein Konto aktiv ist oder soweit für den Betrieb erforderlich.
        Du kannst jederzeit die Löschung deines Kontos und zugehöriger Daten anfordern.
    </string>

    <string name="settings_privacy_choices_title">Deine Optionen</string>
    <string name="settings_privacy_choices_1">App- und Chat-Sprache festlegen</string>
    <string name="settings_privacy_choices_2">Status oder Profilangaben bearbeiten</string>
    <string name="settings_privacy_choices_3">Benachrichtigungen und Werbe-Einwilligung steuern (falls zutreffend)</string>
    <string name="settings_privacy_choices_4">Datenexport anfordern oder Konto löschen</string>

    <string name="settings_privacy_contact_title">Kontakt</string>
    <string name="settings_privacy_contact_body">Für Datenschutz-Anfragen: support@onlyone.app</string>
    <string name="settings_privacy_last_updated">Zuletzt aktualisiert: 9. September 2025</string>

    <!-- Interaktive Datenschutz-Aktionen -->
    <string name="settings_privacy_notif_messages">Nachrichten-Benachrichtigungen</string>
    <string name="settings_privacy_notif_feedback">Feedback- &amp; Promo-Benachrichtigungen</string>
    <string name="settings_privacy_review_consent">Werbe-Einwilligung prüfen</string>
    <string name="settings_privacy_export_data">Meine Daten exportieren</string>
    <string name="settings_privacy_delete_account">Konto löschen</string>

    <!-- Löschdialog -->
    <string name="settings_delete_title">Konto löschen?</string>
    <string name="settings_delete_body">Dies löscht dein Konto und alle zugehörigen Daten dauerhaft. Dieser Vorgang kann nicht rückgängig gemacht werden.</string>
    <string name="settings_delete_confirm">Löschen</string>
    <string name="settings_delete_cancel">Abbrechen</string>
    <string name="settings_delete_success">Konto gelöscht.</string>

</resources>
