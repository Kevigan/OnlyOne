<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Datenschutz (Inhalt + Aktionen) -->
    <string name="settings_privacy_header">Datenschutz</string>
    <string name="settings_privacy_subtitle">Verwalte deine Datenschutz- und Datenoptionen.</string>

    <string name="settings_privacy_intro_title">Kurze Datenschutzerklärung</string>
    <string name="settings_privacy_intro_body">
        Dies ist eine leicht verständliche Übersicht darüber, wie Only One mit deinen Daten umgeht.
        Bei Fragen oder Anfragen kontaktiere uns bitte.
    </string>

    <string name="settings_privacy_collect_title">Welche Daten wir erfassen</string>
    <string name="settings_privacy_collect_1">Deine Konto-E-Mail und deinen Anzeigenamen</string>
    <string name="settings_privacy_collect_2">Statusnachrichten, die du einträgst</string>
    <string name="settings_privacy_collect_3">Nachrichten und Reaktionen, die du sendest oder empfängst</string>
    <string name="settings_privacy_collect_4">Deine Swipe-Nutzung</string>
    <string name="settings_privacy_collect_5">Freundesliste und grundlegende Profildaten</string>
    <string name="settings_privacy_collect_6">Benachrichtigungstoken (für Push-Mitteilungen)</string>

    <string name="settings_privacy_use_title">Wie wir die Daten nutzen</string>
    <string name="settings_privacy_use_1">Um dein Konto zu authentifizieren und dich angemeldet zu halten</string>
    <string name="settings_privacy_use_2">Um Nachrichten, Reaktionen und Benachrichtigungen zuzustellen</string>
    <string name="settings_privacy_use_3">Um tägliche Limits und Swipe-Kontingente durchzusetzen</string>
    <string name="settings_privacy_use_4">Um Zuverlässigkeit zu verbessern und Missbrauch zu verhindern</string>

    <string name="settings_privacy_store_title">Wo die Daten gespeichert werden</string>
    <string name="settings_privacy_store_body">
        Die Authentifizierung erfolgt über Firebase Auth. App-Daten liegen in Firebase Firestore.
        Auf deinem Gerät wird ein kleiner Zwischenspeicher angelegt (z. B. letzte Nachrichten und Profildaten), um die App schneller zu machen.
    </string>

    <string name="settings_privacy_retention_title">Speicherdauer</string>
    <string name="settings_privacy_retention_body">
        Nachrichten werden nach 24 Stunden automatisch vom Server gelöscht.
        Du kannst sie bei Bedarf lokal auf deinem Gerät speichern.
        Letzte Nachrichten und Profildaten werden lokal zwischengespeichert und können automatisch gelöscht werden.
        Serverdaten bleiben gespeichert, solange dein Konto aktiv ist oder solange sie für den Betrieb notwendig sind.
        Du kannst jederzeit die Löschung deines Kontos und der zugehörigen Daten anfordern.
    </string>

    <string name="settings_privacy_choices_title">Deine Möglichkeiten</string>
    <string name="settings_privacy_choices_1">App- und Chatsprache einstellen</string>
    <string name="settings_privacy_choices_2">Status oder Profilinformationen bearbeiten</string>
    <string name="settings_privacy_choices_3">Benachrichtigungen und Werbeeinwilligungen steuern (falls zutreffend)</string>
    <string name="settings_privacy_choices_4">Konto löschen</string>

    <string name="settings_privacy_contact_title">Kontakt</string>
    <string name="settings_privacy_contact_body">Schreibe an arctic.mango@gmx.de für Datenschutzfragen oder -anfragen.</string>
    <string name="settings_privacy_last_updated">Zuletzt aktualisiert: 17. September 2025</string>

    <!-- Falls interaktive Optionen vorhanden -->
    <string name="settings_privacy_notif_messages">Nachrichten-Benachrichtigungen</string>
    <string name="settings_privacy_notif_feedback">Feedback &amp; App-Updates</string>
    <string name="settings_privacy_review_consent">Werbeeinwilligung überprüfen</string>
    <string name="settings_privacy_delete_account">Mein Konto löschen</string>

    <!-- Lösch-Dialog -->
    <string name="settings_delete_title">Konto löschen?</string>
    <string name="settings_delete_body">Dies löscht dein Konto und alle zugehörigen Daten dauerhaft. Dies kann nicht rückgängig gemacht werden.</string>
    <string name="settings_delete_confirm">Löschen</string>
    <string name="settings_delete_cancel">Abbrechen</string>
    <string name="settings_delete_success">Konto gelöscht.</string>
</resources>

